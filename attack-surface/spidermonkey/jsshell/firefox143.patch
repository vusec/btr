+static bool FlushFuncJitPtr(JSContext* cx, unsigned argc, Value* vp) {
+  MEM_BARRIER();
+  CallArgs args = CallArgsFromVp(argc, vp);
+
+  if (args.length() < 1) {
+    JS_ReportErrorNumberASCII(cx, GetErrorMessage, nullptr,
+                              JSMSG_MORE_ARGS_NEEDED, "flushFuncJitPtr", "1", "",
+                              "0");
+    return false;
+  }
+
+  if (!args[0].isObject() || !args[0].toObject().is<JSFunction>()) {
+    JS_ReportErrorASCII(cx, "The first argument must be a function.");
+    return false;
+  }
+
+  JSSprinter sprinter(cx);
+  if (!sprinter.init()) {
+    return false;
+  }
+ 
+  JSFunction* fun = &args[0].toObject().as<JSFunction>();
+  if (!fun->hasJitScript()) {
+    JS_ReportErrorASCII(cx, "The function is not JIT-compiled yet.");
+    return false;
+  }
+
+  BaseScript* script = fun->baseScript();
+  void *addr = (void*) ((uint64_t)script + BaseScript::offsetOfJitCodeRaw());
+  // printf("%p\n", addr);
+  if (addr==NULL) return false;
+  
+  // Flush the d-cache for the slot containing the JIT-code pointer so that
+  // any writes to that slot are visible to the instruction fetch hardware.
+#if defined(__aarch64__)
+  {
+    // Clean D-cache to Point of Unification (PoU), then invalidate I-cache
+    // for that address. Sequence: DC CVAU; DSB; IC IVAU; DSB; ISB
+    __asm__ __volatile__("dc civac, %0" :: "r"(addr) : "memory");
+    __asm__ __volatile__("dsb sy" ::: "memory");
+    // __asm__ __volatile__("ic ivau, %0" :: "r"(addr) : "memory");
+    // __asm__ __volatile__("dsb ish" ::: "memory");
+    __asm__ __volatile__("isb" ::: "memory");
+  }
+#elif defined(__arm__)
+  {
+    // ARMv7/ARMv8 (AArch32) best-effort: fall back to GCC's builtin to ensure
+    // instruction cache coherence for the small slot range.
+    __builtin___clear_cache(reinterpret_cast<char*>(addr),
+                            reinterpret_cast<char*>(addr) + sizeof(void*));
+  }
+#else
+  // On other platforms, rely on the general FlushICache helper which will do
+  // the right thing for the architecture (may perform dcache/icache maintenance
+  // as required).
+  // jit::FlushICache(reinterpret_cast<uint8_t*>(addr), sizeof(void*));
+  __asm__ __volatile__("clflush (%0)" :: "r"(addr) : "memory");
+  __asm__ __volatile__("mfence");
+#endif
+
+  args.rval().setUndefined();
+  return true;
+}
