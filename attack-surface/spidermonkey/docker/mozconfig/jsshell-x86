# FF143 JS shell, x86_64. No --enable-bootstrap: the image already provides
# clang and a pinned rustc, so mach must not try to fetch a toolchain.
ac_add_options --enable-application=js
ac_add_options --enable-js-shell
ac_add_options --enable-jitspew

# Build only the JS shell
ac_add_options --enable-project=js

# Use the image's clang instead of a bootstrapped toolchain.
CC=clang
CXX=clang++

# Enable the debugging tools: Assertions, debug only code etc.
# ac_add_options --enable-debug

# Enable optimizations as well so that the test suite runs much faster. If
# you are having trouble using a debugger, you should disable optimization.
ac_add_options --enable-optimize

# The objdir is set by sm-docker via the MOZ_OBJDIR environment variable, so
# build products land in a mounted directory outside the source tree.
